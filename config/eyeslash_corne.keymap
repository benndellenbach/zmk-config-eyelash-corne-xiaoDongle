#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define FULL 1
#define MOUSE 2
#define FN 3
#define GAME 4
#define NUM 5
#define SYM 6
#define SYS 7
#define GFN 8
#define PREC 9

&mmv_input_listener {
    input-processors = <&zip_xy_scaler 1 1>;

    precise {
        layers = <PREC>;
        input-processors = <&zip_xy_scaler 1 3>;
    };
};

&msc_input_listener { input-processors = <&zip_scroll_scaler 1 1>; };

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <350>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <600>;
    acceleration-exponent = <2>;
    delay-ms = <0>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        back_del: back_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BACK_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPSLOCK>;
        };

        tog_to: tog_to {
            compatible = "zmk,behavior-hold-tap";
            label = "TOG_TO";
            bindings = <&to>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            flavor = "balanced";
        };

        rotary_hue: rotary_hue {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_HUI>, <&rgb_ug RGB_HUD>;

            label = "ROTARY_HUE";
        };

        rgb_tap_hold: rgb_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "RGB_TAP_HOLD";
            bindings = <&rgb_ug>, <&rgb_ug>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            flavor = "tap-preferred";
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        sys_combo_layer {
            if-layers = <FN NUM>;
            then-layer = <SYS>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        combo_leftLP {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <17 18>;
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        combo_rightPT {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <22 23>;
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        combo_leftBR {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <32 33>;
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        combo_rightBR {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <36 37>;
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        combo_leftBT {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 5>;
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        combo_rightBT {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 8>;
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        combo_backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <39 40>;
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        combo_pipe {
            bindings = <&kp PIPE>;
            key-positions = <38 39>;
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        combo_quote {
            bindings = <&mt DOUBLE_QUOTES APOS>;
            key-positions = <10 11>;
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        LeftControl {
            bindings = <&kp LCTRL>;
            key-positions = <14 15>;
            layers = <BASE FULL>;
        };

        LeftShift {
            bindings = <&td0>;
            key-positions = <15 16>;
            layers = <BASE FULL>;
        };

        LeftAlt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <16 17>;
            layers = <BASE FULL>;
        };

        LeftGUI {
            bindings = <&kp LEFT_WIN>;
            key-positions = <14 17>;
            layers = <BASE FULL>;
        };

        RightShift {
            bindings = <&td0>;
            key-positions = <24 25>;
            layers = <BASE FULL>;
        };

        RightControl {
            bindings = <&kp RCTRL>;
            key-positions = <25 26>;
            layers = <BASE FULL>;
        };

        RightAlt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <23 24>;
            layers = <BASE FULL>;
        };

        RightGUI {
            bindings = <&kp LEFT_WIN>;
            key-positions = <23 26>;
            layers = <BASE FULL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base5_layer {
            display-name = "Base5";
            bindings = <
&none  &kp Q  &kp W  &kp E  &kp R  &kp T                 &none                 &kp Y  &kp U  &kp I                &kp O                    &kp P               &none
&none  &kp A  &kp S  &kp D  &kp F  &kp G         &none    &none    &none        &kp H  &kp J  &kp K                &kp L                    &mt COLON SEMI      &none
&none  &kp Z  &kp X  &kp C  &kp V  &kp B         &none             &none        &kp N  &kp M  &mt LESS_THAN COMMA  &mt GREATER_THAN PERIOD  &mt QUESTION SLASH  &none
                       &lt SYM TAB  &lt MOUSE SPACE  &lt NUM ENTER                &lt FN RETURN  &lt MOUSE SPACE  &back_del
            >;

            sensor-bindings = <&inc_dec_kp TAB LS(TAB)>;
        };

        full_layer {
            display-name = "Full";
            bindings = <
&kp TAB           &kp Q  &kp W  &kp E  &kp R  &kp T                           &kp UP                &kp Y  &kp U  &kp I                &kp O                    &kp P               &back_del
&td0              &kp A  &kp S  &kp D  &kp F  &kp G                 &kp LEFT  &kp ENTER  &kp RIGHT  &kp H  &kp J  &kp K                &kp L                    &mt COLON SEMI      &mt DOUBLE_QUOTES APOS
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C  &kp V  &kp B        &to GAME           &kp DOWN              &kp N  &kp M  &mt LESS_THAN COMMA  &mt GREATER_THAN PERIOD  &mt QUESTION SLASH  &kp ESCAPE
                                &lt SYM DELETE  &lt MOUSE SPACE  &lt NUM ENTER                        &lt FN RETURN  &lt MOUSE SPACE  &kp BACKSPACE
            >;

            sensor-bindings = <&inc_dec_kp TAB LS(TAB)>;
        };

        mouse_layer {
            display-name = "mouse";
            bindings = <
&trans  &kp LC(G)  &kp HOME   &kp UP_ARROW  &kp END    &kp PAGE_UP                            &kp LC(UP_ARROW)                 &kp LC(UP)      &mkp MB4        &mmv MOVE_UP    &mkp MB5         &msc SCRL_UP     &trans
&trans  &kp LC(A)  &kp LEFT   &kp DOWN      &kp RIGHT  &kp PAGE_DOWN            &kp LC(LEFT)  &trans            &kp LC(RIGHT)  &kp LC(DOWN)    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_DOWN   &none
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)     &kp LC(V)  &kp LC(Y)      &trans                  &kp LC(DOWN)                     &msc SCRL_LEFT  &kp LC(LEFT)    &mkp MB3        &kp LC(RIGHT)    &msc SCRL_RIGHT  &none
                              &trans        &trans     &trans                                                                  &mkp RCLK       &mkp LCLK       &mo PREC
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        fn_layer {
            display-name = "fn";
            bindings = <
&trans  &trans  &kp F7  &kp F8  &kp F9  &kp F12                                &mmv MOVE_UP                     &kp PG_UP   &kp HOME  &kp UP    &kp END    &kp C_VOL_UP  &trans
&trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp PG_DN   &kp LEFT  &kp DOWN  &kp RIGHT  &kp C_VOL_DN  &trans
&trans  &trans  &kp F1  &kp F2  &kp F3  &kp F10       &trans                    &mmv MOVE_DOWN                   &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp C_MUTE  &trans       &trans
                                &trans  &trans  &trans                                                           &trans      &trans    &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        gaming_layer {
            display-name = "Game";
            bindings = <
&none  &kp TAB    &kp Q  &kp W  &kp E  &kp R                 &none                 &kp Y  &kp U  &kp I      &kp O    &kp P     &none
&none  &kp LSHFT  &kp A  &kp S  &kp D  &kp F         &none    &none    &none        &kp H  &kp J  &kp K      &kp L    &kp SEMI  &none
&none  &kp LCTRL  &kp Z  &kp X  &kp C  &kp V         &to BASE          &none        &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &none
                             &mo GFN  &kp SPACE  &kp G                &kp RET  &kp SPACE  &kp BSPC
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        numpad_layer {
            display-name = "num";
            bindings = <
&trans  &kp GRAVE  &kp F7  &kp F8  &kp F9  &kp F12                                &mmv MOVE_UP                     &kp LBKT   &kp N7  &kp N8  &kp N9  &kp RBKT       &kp GRAVE
&trans  &kp APOS   &kp F4  &kp F5  &kp F6  &kp F11                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp EQUAL  &kp N4  &kp N5  &kp N6  &kp COLON      &trans
&trans  &trans     &kp F1  &kp F2  &kp F3  &kp F10       &trans                    &mmv MOVE_DOWN                   &kp MINUS  &kp N1  &kp N2  &kp N3  &kp BACKSLASH  &trans
                                   &trans  &trans  &trans                                                           &trans     &kp N0  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        sym_layer {
            display-name = "Sym";
            bindings =
