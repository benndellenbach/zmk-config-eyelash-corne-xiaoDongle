#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        back_del: back_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BACK_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPSLOCK>;
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        combo_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <23 24>;
        };

        combo_leftLP {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <17 18>;
        };

        combo_leftBR {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <32 33>;
        };

        combo_leftBT {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 5>;
        };

        combo_rightPT {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <22 23>;
        };

        combo_rightBR {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <36 37>;
        };

        combo_rightBT {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 8>;
        };

        combo_backslash {
            bindings = <&kp NON_US_BACKSLASH>;
            key-positions = <40 39>;
        };

        combo_pipe {
            bindings = <&kp PIPE>;
            key-positions = <40 41>;
        };

        LeftShift {
            bindings = <&td0>;
            key-positions = <15 16>;
            layers = <0 3>;
        };

        LeftGUI {
            bindings = <&kp LEFT_WIN>;
            key-positions = <14 17>;
            layers = <0 3>;
        };

        RightControl {
            bindings = <&kp RCTRL>;
            key-positions = <25 26>;
        };

        LeftAlt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <16 17>;
            layers = <0 3>;
        };

        RightShift {
            bindings = <&td0>;
            key-positions = <24 25>;
            layers = <0 3>;
        };

        RightGUI {
            bindings = <&kp LEFT_WIN>;
            key-positions = <23 26>;
        };

        RightAlt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <23 24>;
        };

        LeftControl {
            bindings = <&kp LCTRL>;
            key-positions = <15 14>;
            layers = <0 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&mt GRAVE TAB     &kp Q  &kp W  &kp E         &kp R        &kp T                           &kp UP                &kp Y      &kp U        &kp I          &kp O    &kp P     &back_del
&td0              &kp A  &kp S  &kp D         &kp F        &kp G                 &kp LEFT  &kp ENTER  &kp RIGHT  &kp H      &kp J        &kp K          &kp L    &kp SEMI  &kp SQT
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C         &kp V        &kp B        &to 4              &kp DOWN              &kp N      &kp M        &kp COMMA      &kp DOT  &kp FSLH  &kp ESCAPE
                                &lt 5 DELETE  &lt 1 SPACE  &lt 3 ENTER                                           &kp ENTER  &lt 2 SPACE  &kp BACKSPACE
            >;

            sensor-bindings = <&inc_dec_kp TAB LS(TAB)>;
        };

        Mouse {
            display-name = "mouse";
            bindings = <
&trans  &kp G  &kp H  &kp Z   &kp Z   &kp F                           &kp LC(UP_ARROW)                 &trans          &mkp MB4        &mmv MOVE_UP    &mkp MB5         &trans           &trans
&trans  &kp A  &kp X  &kp C   &kp V   &kp R             &kp LC(LEFT)  &trans            &kp LC(RIGHT)  &trans          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans           &none
&trans  &kp N  &kp O  &kp S   &kp T   &kp P   &trans                  &kp LC(DOWN)                     &msc SCRL_LEFT  &msc SCRL_DOWN  &mkp MB3        &msc SCRL_UP     &msc SCRL_RIGHT  &none
                      &trans  &trans  &trans                                                           &mkp RCLK       &mkp LCLK       &kp BACKSPACE
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        Function {
            display-name = "fn";
            bindings = <
&trans           &kp F1           &kp F2           &kp F3           &kp F4           &kp F5                                              &mmv MOVE_UP                     &trans          &trans          &kp UP_ARROW  &trans        &trans        &trans
&trans           &kp F6           &kp F7           &kp F8           &kp F9           &kp F10                             &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &bt BT_CLR      &kp LEFT_ARROW  &kp UP_ARROW  &kp RIGHT     &trans        &trans
&rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &rgb_ug RGB_TOG                    &mmv MOVE_DOWN                   &bt BT_CLR_ALL  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &trans
                                                   &out OUT_USB     &out OUT_TOG     &out OUT_BLE                                                                         &trans          &trans          &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PLUS) LC(MINUS)>;
        };

        Numpad {
            display-name = "Num";
            bindings = <
&trans  &kp F1           &kp F2           &kp F3           &kp F4           &kp F5                                     &mmv MOVE_UP                     &kp LBKT   &kp N7        &kp N8         &kp N9  &kp RBKT   &kp RBKT
&trans  &kp F6           &kp F7           &kp F8           &kp F9           &kp F10                    &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp EQUAL  &kp NUMBER_4  &kp N5         &kp N6  &kp COLON  &kp EQUAL
&trans  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &trans                    &mmv MOVE_DOWN                   &kp MINUS  &kp N1        &kp N2         &kp N3  &kp FSLH   &trans
                                          &trans           &trans           &trans                                                                      &kp ENTER  &kp N0        &kp BACKSPACE
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        Gaming {
            display-name = "Game";
            bindings = <
&kp T  &kp TAB    &kp Q  &kp W    &kp E      &kp R                           &kp NUMBER_1                &trans          &mkp MB4        &mmv MOVE_UP    &mkp MB5         &trans           &trans
&kp G  &kp LSHFT  &kp A  &kp S    &kp D      &kp F             &kp NUMBER_4  &trans        &kp NUMBER_2  &trans          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans           &none
&kp B  &kp LCTRL  &kp Z  &kp X    &kp C      &kp V    &to 0                  &kp NUMBER_3                &msc SCRL_LEFT  &msc SCRL_DOWN  &mkp MB3        &msc SCRL_UP     &msc SCRL_RIGHT  &none
                         &kp TAB  &kp SPACE  &kp RET                                                     &mkp RCLK       &mkp LCLK       &kp BACKSPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        Symbols {
            display-name = "Sym";
            bindings = <
&trans  &kp F1           &kp F2           &kp F3           &kp F4           &kp F5                                     &mmv MOVE_UP                     &kp LS(LBRC)  &kp LS(AMPS)  &kp LS(STAR)   &kp LS(LPAR)   &kp LS(RBRC)  &kp LS(RBRC)
&trans  &kp F6           &kp F7           &kp F8           &kp F9           &kp F10                    &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp PLUS      &kp LS(DLLR)  &kp LS(PRCNT)  &kp LS(CARET)  &kp COLON     &kp EQUAL
&trans  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &trans                    &mmv MOVE_DOWN                   &kp MINUS     &kp LS(EXCL)  &kp LS(EXCL)   &kp LS(AT)     &kp BSLH      &trans
                                          &trans           &trans           &trans                                                                      &kp ENTER     &kp LS(RPAR)  &kp SPACE
            >;

            sensor-bindings = <&scroll_encoder>;
        };
    };
};
