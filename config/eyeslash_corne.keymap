// Eyelash Corne: 5-column TRAINER keymap
// - Base layer uses only the inner 5 columns + 3 thumbs per side (the future 36-key board).
//   Outer columns and the center cluster are &none on the base layer.
// - Your original full layout is kept as layer 1 ("Full"): toggle it from the System layer
//   (hold both inner thumbs, then tap H) whenever you need to get real work done.
// - New System layer: hold BOTH inner thumbs. Bluetooth, USB/BLE output, RGB, reset all live there.
//
// Layers: 0 Base5 | 1 Full | 2 Mouse | 3 Fn | 4 Game | 5 Num | 6 Sym | 7 System

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define FULL 1
#define MOUSE 2
#define FN 3
#define GAME 4
#define NUM 5
#define SYM 6
#define SYS 7

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;     // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    behaviors {
        back_del: back_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BACK_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_RSFT|MOD_LSFT)>;
        };

        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPSLOCK>;
        };

        tog_to: tog_to {
            compatible = "zmk,behavior-hold-tap";
            label = "TOG_TO";
            bindings = <&to>, <&tog>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            flavor = "balanced";
        };

        rotary_hue: rotary_hue {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_HUI>, <&rgb_ug RGB_HUD>;

            label = "ROTARY_HUE";
        };

        // Hold = first param, tap = second param.
        // Use the *_CMD names with this behavior (one cell each), not RGB_EFF / RGB_TOG.
        rgb_tap_hold: rgb_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "RGB_TAP_HOLD";
            bindings = <&rgb_ug>, <&rgb_ug>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            flavor = "tap-preferred";
        };
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    // Hold both inner thumbs (Num + Fn) = System layer
    conditional_layers {
        compatible = "zmk,conditional-layers";

        sys_combo_layer {
            if-layers = <FN NUM>;
            then-layer = <SYS>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // ---- Symbol combos: typing layers only, and only after a short pause,
        //      so fast rolls like "rt" or "fg" don't misfire.
        combo_esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;              // Q + W  (moved from J + K so Right Alt can mirror Left Alt)
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        combo_leftLP {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <17 18>;            // F + G
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        combo_rightPT {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <22 23>;            // H + J
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        combo_leftBR {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <32 33>;            // V + B
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        combo_rightBR {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <36 37>;            // N + M
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        combo_leftBT {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <4 5>;              // R + T
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        combo_rightBT {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <7 8>;              // Y + U
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        combo_backslash {
            bindings = <&kp BACKSLASH>;
            key-positions = <39 40>;            // . + /
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        combo_pipe {
            bindings = <&kp PIPE>;
            key-positions = <38 39>;            // , + .   (moved: the old spot used the outer column)
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        // NEW: apostrophe (tap) / double quote (hold), replaces the outer-column key
        combo_quote {
            bindings = <&mt DOUBLE_QUOTES APOS>;
            key-positions = <10 11>;            // O + P
            layers = <BASE FULL>;
            require-prior-idle-ms = <150>;
        };

        // ---- Home-row modifier combos, mirrored on both hands (no idle requirement, so Shift works mid-word)
        //      Left:  A+S Ctrl | S+D Shift | D+F Alt | A+F GUI
        //      Right: ;+L Ctrl | L+K Shift | K+J Alt | ;+J GUI
        LeftControl {
            bindings = <&kp LCTRL>;
            key-positions = <14 15>;            // A + S
            layers = <BASE FULL>;
        };

        LeftShift {
            bindings = <&td0>;
            key-positions = <15 16>;            // S + D (double-tap = Caps Lock)
            layers = <BASE FULL>;
        };

        LeftAlt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <16 17>;            // D + F
            layers = <BASE FULL>;
        };

        LeftGUI {
            bindings = <&kp LEFT_WIN>;
            key-positions = <14 17>;            // A + F
            layers = <BASE FULL>;
        };

        RightShift {
            bindings = <&td0>;
            key-positions = <24 25>;            // K + L
            layers = <BASE FULL>;
        };

        RightControl {
            bindings = <&kp RCTRL>;
            key-positions = <25 26>;            // L + ;
            layers = <BASE FULL>;
        };

        RightAlt {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <23 24>;            // J + K  (mirrors D + F)
            layers = <BASE FULL>;
        };

        RightGUI {
            bindings = <&kp LEFT_WIN>;
            key-positions = <23 26>;            // J + ;  (mirrors A + F)
            layers = <BASE FULL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // 0: 5-COLUMN BASE (outer columns + center cluster disabled)
        base5_layer {
            display-name = "Base5";
            bindings = <
&none  &kp Q  &kp W  &kp E  &kp R  &kp T                 &none                 &kp Y  &kp U  &kp I                &kp O                    &kp P               &none
&none  &kp A  &kp S  &kp D  &kp F  &kp G         &none    &none    &none        &kp H  &kp J  &kp K                &kp L                    &mt COLON SEMI      &none
&none  &kp Z  &kp X  &kp C  &kp V  &kp B         &none             &none        &kp N  &kp M  &mt LESS_THAN COMMA  &mt GREATER_THAN PERIOD  &mt QUESTION SLASH  &none
                       &lt SYM TAB  &lt MOUSE SPACE  &lt NUM ENTER                &lt FN RETURN  &lt MOUSE SPACE  &back_del
            >;

            sensor-bindings = <&inc_dec_kp TAB LS(TAB)>;
        };

        // 1: YOUR ORIGINAL FULL LAYOUT (toggle from System: both inner thumbs + H)
        full_layer {
            display-name = "Full";
            bindings = <
&kp TAB           &kp Q  &kp W  &kp E  &kp R  &kp T                           &kp UP                &kp Y  &kp U  &kp I                &kp O                    &kp P               &back_del
&td0              &kp A  &kp S  &kp D  &kp F  &kp G                 &kp LEFT  &kp ENTER  &kp RIGHT  &kp H  &kp J  &kp K                &kp L                    &mt COLON SEMI      &mt DOUBLE_QUOTES APOS
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C  &kp V  &kp B        &to GAME           &kp DOWN              &kp N  &kp M  &mt LESS_THAN COMMA  &mt GREATER_THAN PERIOD  &mt QUESTION SLASH  &kp ESCAPE
                                &lt SYM DELETE  &lt MOUSE SPACE  &lt NUM ENTER                        &lt FN RETURN  &lt MOUSE SPACE  &kp BACKSPACE
            >;

            sensor-bindings = <&inc_dec_kp TAB LS(TAB)>;
        };

        // 2: MOUSE / NAV (hold either space). Ctrl+arrows copied into the 5 columns.
        mouse_layer {
            display-name = "mouse";
            bindings = <
&trans  &kp LC(G)  &kp HOME   &kp UP_ARROW  &kp END    &kp PAGE_UP                            &kp LC(UP_ARROW)                 &kp LC(UP)      &mkp MB4        &mmv MOVE_UP    &mkp MB5         &kp LC(DOWN)     &trans
&trans  &kp LC(A)  &kp LEFT   &kp DOWN      &kp RIGHT  &kp PAGE_DOWN            &kp LC(LEFT)  &trans            &kp LC(RIGHT)  &kp LC(LEFT)    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp LC(RIGHT)    &none
&trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)     &kp LC(V)  &kp P          &trans                  &kp LC(DOWN)                     &msc SCRL_LEFT  &msc SCRL_DOWN  &mkp MB3        &msc SCRL_UP     &msc SCRL_RIGHT  &none
                              &trans        &trans     &trans                                                                  &mkp RCLK       &mkp LCLK       &kp BACKSPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        // 3: FUNCTION (hold right inner thumb). Bluetooth moved to System; right hand = media + arrows.
        fn_layer {
            display-name = "fn";
            bindings = <
&trans  &trans  &kp F7  &kp F8  &kp F9  &kp F12                                &mmv MOVE_UP                     &kp C_PREV  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT  &kp C_PP   &trans
&trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp LEFT    &kp DOWN      &kp UP        &kp RIGHT   &trans     &trans
&trans  &trans  &kp F1  &kp F2  &kp F3  &kp F10       &trans                    &mmv MOVE_DOWN                   &kp HOME    &kp PG_DN     &kp PG_UP     &kp END     &trans     &trans
                                &trans  &trans  &trans                                                           &trans      &trans        &trans
            >;

            sensor-bindings = <&rotary_hue>;
        };

        // 4: GAMING (unchanged; uses the full board. Center key = back to base)
        gaming_layer {
            display-name = "Game";
            bindings = <
&kp T  &kp TAB     &kp Q  &kp W             &kp E      &kp R                           &kp NUMBER_1                &trans          &mkp MB4        &mmv MOVE_UP    &mkp MB5         &trans           &trans
&kp G  &kp LSHFT   &kp A  &kp S             &kp D      &kp F             &kp NUMBER_4  &trans        &kp NUMBER_2  &trans          &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans           &none
&kp B  &kp ESCAPE  &kp Z  &kp X             &kp C      &kp V    &to BASE               &kp NUMBER_3                &msc SCRL_LEFT  &msc SCRL_DOWN  &mkp MB3        &msc SCRL_UP     &msc SCRL_RIGHT  &none
                          &kp LEFT_CONTROL  &kp SPACE  &kp RET                                                     &mkp RCLK       &mkp LCLK       &kp BACKSPACE
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        // 5: NUMPAD (hold left inner thumb). RGB moved to System; ` and ' fill the old RGB column.
        numpad_layer {
            display-name = "num";
            bindings = <
&trans  &kp GRAVE  &kp F7  &kp F8  &kp F9  &kp F12                                &mmv MOVE_UP                     &kp LBKT   &kp N7  &kp N8  &kp N9  &kp RBKT       &kp GRAVE
&trans  &kp APOS   &kp F4  &kp F5  &kp F6  &kp F11                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp EQUAL  &kp N4  &kp N5  &kp N6  &kp COLON      &trans
&trans  &trans     &kp F1  &kp F2  &kp F3  &kp F10       &trans                    &mmv MOVE_DOWN                   &kp MINUS  &kp N1  &kp N2  &kp N3  &kp BACKSLASH  &trans
                                   &trans  &trans  &trans                                                           &trans     &kp N0  &trans
            >;

            sensor-bindings = <&rotary_hue>;
        };

        // 6: SYMBOLS (hold left outer thumb). ~ and " fill the old RGB column.
        sym_layer {
            display-name = "Sym";
            bindings = <
&trans  &kp TILDE          &kp F7  &kp F8  &kp F9  &kp F12                                &mmv MOVE_UP                     &kp RS(LBKT)   &kp RS(N7)  &kp RS(N8)  &kp RS(N9)  &kp RS(RBKT)       &kp RS(GRAVE)
&trans  &kp DOUBLE_QUOTES  &kp F4  &kp F5  &kp F6  &kp F11                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp RS(EQUAL)  &kp RS(N4)  &kp RS(N5)  &kp RS(N6)  &kp COLON          &trans
&trans  &trans             &kp F1  &kp F2  &kp F3  &kp F10       &trans                    &mmv MOVE_DOWN                   &kp RS(MINUS)  &kp RS(N1)  &kp RS(N2)  &kp RS(N3)  &kp RS(BACKSLASH)  &trans
                                           &trans  &trans  &trans                                                           &trans         &kp RS(N0)  &trans
            >;

            sensor-bindings = <&rotary_hue>;
        };

        // 7: SYSTEM (hold BOTH inner thumbs)
        //    Left hand:  outputs on the top row, Bluetooth profiles on the home row,
        //                clear / prev / next on the bottom row, game mode on B.
        //    Right hand: RGB, Full-layout toggle on H, reset + bootloader on the bottom row.
        system_layer {
            display-name = "System";
            bindings = <
&none  &out OUT_USB   &out OUT_TOG   &out OUT_BLE   &none          &none                      &none                  &rgb_ug RGB_TOG  &rgb_ug RGB_EFF  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &none
&none  &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4      &none  &none  &none          &tog FULL        &rgb_ug RGB_EFR  &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &none
&none  &bt BT_CLR     &bt BT_PRV     &bt BT_NXT     &none          &to GAME          &none         &none            &rgb_ug RGB_SPD  &rgb_ug RGB_SPI  &none            &sys_reset       &bootloader      &none
                                     &trans         &trans         &trans                                           &trans           &trans           &trans
            >;

            sensor-bindings = <&rgb_encoder>;
        };
    };
};
